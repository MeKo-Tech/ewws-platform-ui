package views

import "strconv"

// Usage renders GET /usage: logins per app from ewws-auth (admin only).
templ Usage(props PageProps, o UsageOverview) {
	@Layout(props) {
		<section class="hero">
			<h1>Nutzung</h1>
			<p>
				Logins pro App aus ewws-auth — Fenster 1, 7 und 30 Tage
				if o.Today != "" {
					bis { o.Today } (UTC).
				} else {
					bis heute (UTC).
				}
			</p>
		</section>
		if len(o.EnvTabs) > 0 {
			@usageEnvSwitch(o.EnvTabs)
		}
		for _, n := range o.EnvNotices {
			@usageEnvNotice(n)
		}
		if len(o.EnvNotices) == 0 {
			@usageStateBox(o.State, o.Message)
		}
		if o.State == UsageOK {
			@usageOverviewTable(o.Rows, o.ShowEnv)
			if o.ShowEnv {
				@usagePersonsSection(o)
			}
			if len(o.Silent) > 0 {
				@usageSilentSection(o.Silent)
			}
			if len(o.NoLogin) > 0 {
				@usageNoLoginSection(o)
			}
		}
	}
}

// usageEnvSwitch links the environments (one ewws-auth each) and "Beide".
templ usageEnvSwitch(tabs []UsageEnvTab) {
	<nav class="toolbar usage-env" aria-label="Umgebung">
		<span class="muted">Umgebung</span>
		<div class="view-toggle">
			for _, t := range tabs {
				if t.Active {
					<a class="view-btn is-active" href={ templ.URL(t.URL) } aria-current="page">{ t.Label }</a>
				} else {
					<a class="view-btn" href={ templ.URL(t.URL) }>{ t.Label }</a>
				}
			}
		</div>
	</nav>
}

// usageEnvNotice is the failure of one environment in the "Beide" view.
templ usageEnvNotice(n UsageEnvNotice) {
	<div class="alert alert--error" role="alert">
		<strong>{ n.EnvLabel }:</strong>
		switch n.State {
			case UsageForbidden:
				Recht <code>auth:activity:r</code> fehlt für den Maschinen-Account.
			case UsageNotConfigured:
				ewws-auth nicht konfiguriert.
			default:
				{ n.Message }
		}
	</div>
}

templ usageEnvBadge(label string) {
	<span class="badge badge--neutral">{ label }</span>
}

// usageStateBox renders the notice for every state but UsageOK.
templ usageStateBox(state UsageState, message string) {
	switch state {
		case UsageNotConfigured:
			<div class="alert alert--neutral" role="status">
				<strong>ewws-auth nicht konfiguriert.</strong>
				Es fehlen <code>EWWS_AUTH_URL</code>, <code>EWWS_AUTH_MACHINE_CLIENT_ID</code>
				oder <code>EWWS_AUTH_MACHINE_CLIENT_SECRET</code>.
			</div>
		case UsageForbidden:
			<div class="alert alert--error" role="alert">
				<strong>Recht auth:activity:r fehlt.</strong>
				Der Maschinen-Account der Platform-UI braucht in ewws-auth die Freigabe
				<code>auth:activity:r</code>, um Login-Aktivität lesen zu dürfen.
			</div>
		case UsageInvalid:
			<div class="alert alert--error" role="alert">
				<strong>Ungültige Anfrage:</strong> { message }
			</div>
		case UsageError:
			<div class="alert alert--error" role="alert">
				<strong>ewws-auth nicht erreichbar:</strong> { message }
			</div>
	}
}

templ usageOverviewTable(rows []UsageRow, showEnv bool) {
	<table class="tenants-table usage-table">
		<thead>
			<tr>
				<th rowspan="2">App</th>
				if showEnv {
					<th rowspan="2">Umgebung</th>
				}
				<th rowspan="2">ewws-auth Name</th>
				<th rowspan="2">client_id</th>
				<th rowspan="2">Issuer</th>
				<th colspan="2" class="usage-table__group">1 Tag</th>
				<th colspan="2" class="usage-table__group">7 Tage</th>
				<th colspan="2" class="usage-table__group">30 Tage</th>
			</tr>
			<tr>
				<th class="num">Nutzer</th>
				<th class="num">Logins</th>
				<th class="num">Nutzer</th>
				<th class="num">Logins</th>
				<th class="num">Nutzer</th>
				<th class="num">Logins</th>
			</tr>
		</thead>
		<tbody>
			if len(rows) == 0 {
				<tr><td colspan={ usageColspan(10, showEnv) } class="empty">Keine Aktivität in den letzten 30 Tagen.</td></tr>
			}
			for _, r := range rows {
				<tr class="tenant-row">
					<td>
						if r.AppSlug != "" {
							<a href={ templ.URL("/app/" + r.AppSlug) }>{ r.AppSlug }</a>
							if len(r.AppStages) > 0 {
								<small class="muted">{ usageStages(r.AppStages) }</small>
							}
							if r.Visits {
								<small class="muted">ohne Login</small>
							}
						} else if r.Name != "" {
							{ r.Name }
						} else {
							<span class="muted">—</span>
						}
					</td>
					if showEnv {
						<td>
							@usageEnvBadge(r.EnvLabel)
						</td>
					}
					<td>
						{ r.Name }
						if !r.Registered {
							<span class="badge badge--warn" title="client_id ist in ewws-auth nicht registriert">nicht registriert</span>
						}
					</td>
					<td><a class="mono" href={ templ.URL(r.DetailURL) }>{ usageClientLabel(r.ClientID) }</a></td>
					<td>{ r.Issuer }</td>
					@usageWindowCells(r.Last1d, r.Visits)
					@usageWindowCells(r.Last7d, r.Visits)
					@usageWindowCells(r.Last30d, r.Visits)
				</tr>
			}
		</tbody>
	</table>
}

// usageWindowCells renders Nutzer and Logins of one window; a visits row
// (app without login) has no logins, so that cell shows "—".
templ usageWindowCells(w UsageWindow, visits bool) {
	<td class="num">{ strconv.Itoa(w.Users) }</td>
	if visits {
		<td class="num muted" title="App ohne Login – Aufrufe stehen unter „kein Login“">—</td>
	} else {
		<td class="num">{ strconv.Itoa(w.Logins) }</td>
	}
}

templ usageSilentSection(silent []UsageSilent) {
	<section class="detail-section">
		<h2>Ohne Aktivität</h2>
		<p class="muted">client_ids aus der Registry, für die ewws-auth in den letzten 30 Tagen keinen Login kennt.</p>
		<table class="tenants-table usage-table">
			<thead>
				<tr>
					<th>App</th>
					<th>Stage</th>
					if usageSilentHasEnv(silent) {
						<th>Umgebung</th>
					}
					<th>client_id</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range silent {
					<tr>
						<td><a href={ templ.URL("/app/" + s.AppSlug) }>{ s.AppSlug }</a></td>
						<td>{ s.Stage }</td>
						if usageSilentHasEnv(silent) {
							<td>
								@usageEnvBadge(s.EnvLabel)
							</td>
						}
						<td class="mono">{ usageClientLabel(s.ClientID) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

templ usageNoLoginSection(o UsageOverview) {
	<section class="detail-section">
		<h2>kein Login</h2>
		<div class="alert alert--info" role="note">
			Diese Apps nennen keine <code>auth.client_ids</code> im Claim. Für viele Apps ist das
			gewollt (öffentlich oder ohne Anmeldung) — das ist kein Fehler.
		</div>
		if o.VisitsOK {
			<p class="muted">
				Aufrufe der letzten { strconv.Itoa(o.VisitsDays) } Tage, von ewws-auth per Beacon erfasst:
				Personen sind erkannte Accounts, anonyme Geräte Aufrufe ohne erkannte Anmeldung.
			</p>
			if o.VisitsHint != "" {
				<p class="muted" role="status">{ o.VisitsHint }</p>
			}
			<table class="tenants-table usage-table">
				<thead>
					<tr>
						<th>App</th>
						if o.ShowEnv {
							<th>Umgebung</th>
						}
						<th class="num">Personen</th>
						<th class="num">anonyme Geräte</th>
						<th class="num">Aufrufe</th>
						<th>zuletzt gesehen</th>
					</tr>
				</thead>
				<tbody>
					for _, a := range o.NoLogin {
						<tr class="tenant-row">
							<td><a href={ templ.URL("/app/" + a.Slug) }>{ a.Slug }</a></td>
							if o.ShowEnv {
								<td>
									@usageEnvBadge(a.EnvLabel)
								</td>
							}
							<td class="num">
								if a.Accounts > 0 {
									<a href={ templ.URL(a.DetailURL) } title="Personen anzeigen">{ strconv.Itoa(a.Accounts) }</a>
								} else {
									0
								}
							</td>
							<td class="num">{ strconv.Itoa(a.Devices) }</td>
							<td class="num">{ strconv.Itoa(a.Views) }</td>
							<td>{ fmtUsageTime(a.LastSeenAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		} else {
			if o.VisitsHint != "" {
				<p class="muted" role="status">{ o.VisitsHint }</p>
			}
			<ul class="usage-slugs">
				for _, a := range o.NoLogin {
					<li><a href={ templ.URL("/app/" + a.Slug) }>{ a.Slug }</a></li>
				}
			</ul>
		}
	</section>
}

// usagePersonsSection compares each person's use across environments.
templ usagePersonsSection(o UsageOverview) {
	<section class="detail-section usage-persons">
		<h2>Personen nach Umgebung</h2>
		<p class="muted">
			Logins + Refreshes + Nutzungen je Person über alle Apps
			if o.PersonsFrom != "" {
				vom { o.PersonsFrom } bis { o.PersonsTo } (UTC).
			}
			Personen werden über Personio-ID, sonst Namen zusammengeführt; Maschinen-Accounts
			sind nicht unterscheidbar und zählen mit. „aktive Tage“ ist das Maximum über die Apps.
		</p>
		if o.PersonsHint != "" {
			<p class="muted" role="status">{ o.PersonsHint }</p>
		}
		<table class="tenants-table usage-table">
			<thead>
				<tr>
					<th rowspan="2">Person</th>
					for _, label := range o.PersonEnvs {
						<th colspan="2" class="usage-table__group">{ label }</th>
					}
					<th rowspan="2" class="num">Gesamt</th>
					<th rowspan="2">überwiegend</th>
				</tr>
				<tr>
					for range o.PersonEnvs {
						<th class="num">Nutzung</th>
						<th class="num">aktive Tage</th>
					}
				</tr>
			</thead>
			<tbody>
				if len(o.Persons) == 0 {
					<tr><td colspan={ strconv.Itoa(3 + 2*len(o.PersonEnvs)) } class="empty">Keine Aktivität in den letzten 30 Tagen.</td></tr>
				}
				for _, p := range o.Persons {
					<tr class="tenant-row">
						<td>
							if p.Name != "" {
								{ p.Name }
							} else {
								<span class="mono">{ p.AccountID }</span>
							}
						</td>
						for _, e := range p.PerEnv {
							<td class="num" title={ usagePersonEnvTitle(e) }>{ strconv.Itoa(e.Total) }</td>
							<td class="num">{ strconv.Itoa(e.ActiveDays) }</td>
						}
						<td class="num">{ strconv.Itoa(p.Total) }</td>
						<td>
							if p.Dominant != "" {
								@usageEnvBadge(p.Dominant)
							} else {
								<span class="muted">gleich</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

// UsageDetailPage renders GET /usage/{client_id}: per-account activity.
templ UsageDetailPage(props PageProps, d UsageDetail) {
	@Layout(props) {
		<p><a href={ templ.URL(usageBackURL(d)) }>← Nutzung</a></p>
		<section class="hero">
			<h1>
				{ usageDetailTitle(d) }
				if d.AppSlug != "" {
					<small>· <a href={ templ.URL("/app/" + d.AppSlug) }>{ d.AppSlug }</a></small>
				}
			</h1>
			<dl class="kv">
				<dt>client_id</dt>
				<dd class="mono">{ usageClientLabel(d.ClientID) }</dd>
				<dt>Issuer</dt>
				<dd>{ usageIssuerLabel(d.Issuer) }</dd>
				if d.EnvLabel != "" {
					<dt>Umgebung</dt>
					<dd>
						@usageEnvBadge(d.EnvLabel)
					</dd>
				}
				if d.State == UsageOK {
					<dt>Registriert</dt>
					<dd>
						if d.Registered {
							<span class="badge badge--ok">registriert</span>
						} else {
							<span class="badge badge--warn">nicht registriert</span>
						}
					</dd>
				}
			</dl>
		</section>
		if d.State == UsageOK || d.State == UsageInvalid {
			@usageRangeForm(d)
		}
		@usageStateBox(d.State, d.Message)
		if d.State == UsageOK {
			@usageAccountsTable(d.Accounts)
		}
	}
}

templ usageRangeForm(d UsageDetail) {
	<form method="get" action={ templ.URL(d.FormAction) } class="toolbar usage-range">
		<label>Von <input type="date" name="from" value={ d.From }/></label>
		<label>Bis <input type="date" name="to" value={ d.To }/></label>
		<input type="hidden" name="issuer" value={ d.Issuer }/>
		if d.Env != "" {
			<input type="hidden" name="env" value={ d.Env }/>
		}
		<button type="submit" class="btn-primary">Anzeigen</button>
		<small class="muted">höchstens 366 Tage</small>
	</form>
}

templ usageAccountsTable(accounts []UsageAccount) {
	<table class="tenants-table usage-table">
		<thead>
			<tr>
				<th>Name</th>
				<th>Personio-ID</th>
				<th class="num">Logins</th>
				<th class="num">Refreshes</th>
				<th class="num">Nutzungen</th>
				<th class="num">aktive Tage</th>
				<th>zuletzt gesehen</th>
			</tr>
		</thead>
		<tbody>
			if len(accounts) == 0 {
				<tr><td colspan="7" class="empty">Keine Logins im Zeitraum.</td></tr>
			}
			for _, a := range accounts {
				<tr class="tenant-row">
					<td>
						if a.Name != "" {
							{ a.Name }
						} else {
							<span class="mono">{ a.AccountID }</span>
						}
					</td>
					<td>
						if a.PersonioID != "" {
							{ a.PersonioID }
						} else {
							<span class="muted">—</span>
						}
					</td>
					<td class="num">{ strconv.Itoa(a.Logins) }</td>
					<td class="num">{ strconv.Itoa(a.Refreshes) }</td>
					<td class="num">{ strconv.Itoa(a.Uses) }</td>
					<td class="num">{ strconv.Itoa(a.ActiveDays) }</td>
					<td>{ fmtUsageTime(a.LastSeenAt) }</td>
				</tr>
			}
		</tbody>
	</table>
}
