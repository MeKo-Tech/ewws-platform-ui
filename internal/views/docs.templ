package views

// Links the docs page points to instead of duplicating their details.
const (
	docsOnboardingURL = "https://github.com/MeKo-Tech/ewws-apps-registry/blob/main/docs/onboarding.md"
	docsClaimRefURL   = "https://github.com/MeKo-Tech/ewws-apps-registry/blob/main/README.md#claim-reference"
	docsRunbookURL    = "https://github.com/MeKo-Tech/ewws-wiki/blob/main/02_Softwareentwicklung/02_Tech/08_App-Plattform/neue_vibe_app_freischalten.md"
	docsTemplateURL   = "https://github.com/MeKo-Tech/go-react-template"
	docsTemplateAgent = "https://github.com/MeKo-Tech/go-react-template/blob/main/AGENTS.md"
	docsAuthClients   = "https://github.com/MeKo-Tech/ewws-auth/blob/main/docs/clients.md"
	docsReservedSlugs = "https://github.com/MeKo-Tech/ewws-apps-registry/blob/main/reserved-slugs.yaml"
)

// Docs is the long-form onboarding page rendered at /docs. Pure static
// content — no per-tenant state, no scanners — so everything is inlined in
// the template and the layout's CSS handles the typography. The detailed
// rules live in the registry onboarding guide, the ewws-wiki runbook and
// the MeKoMCP guide; this page gives the overview and links there.
templ Docs(props PageProps) {
	@Layout(props) {
		<section class="hero">
			<h1>Platform docs</h1>
			<p>
				Wie eine Vibe-App vom Template bis zum laufenden Deployment kommt, wie Secrets
				und Login funktionieren und wo die Grenzen der Plattform liegen.
			</p>
		</section>
		<nav class="docs-toc" aria-label="Inhaltsverzeichnis">
			<ol>
				<li><a href="#flow">1. Der Ablauf im Überblick</a></li>
				<li><a href="#template">2. Repo aus dem Template</a></li>
				<li><a href="#claim">3. Claim über das Formular</a></li>
				<li><a href="#review">4. Freigabe durch EWWS</a></li>
				<li><a href="#deploy">5. Build, Tag und Deploy</a></li>
				<li><a href="#secrets">6. Secrets (SOPS → SealedSecrets)</a></li>
				<li><a href="#login">7. Login über ewws-auth</a></li>
				<li><a href="#resources">8. Ressourcen und Container-Regeln</a></li>
				<li><a href="#faq">9. FAQ und Hilfe</a></li>
			</ol>
		</nav>
		@docsFlowSection()
		@docsTemplateSection()
		@docsClaimSection()
		@docsReviewSection()
		@docsDeploySection()
		@docsSecretsSection()
		@docsLoginSection()
		@docsResourcesSection()
		@docsFAQSection()
	}
}

templ docsFlowSection() {
	<section class="docs-section" id="flow">
		<h2>1. Der Ablauf im Überblick</h2>
		<ol>
			<li><strong>Template:</strong> Repo aus <a href={ templ.SafeURL(docsTemplateURL) }><code>go-react-template</code></a> anlegen (privat, unter <code>MeKo-Tech</code>).</li>
			<li><strong>Claim:</strong> über das <a href="/claim">Claim-Formular</a> einen PR gegen <a href="https://github.com/MeKo-Tech/ewws-apps-registry"><code>ewws-apps-registry</code></a> öffnen (<code>apps/&lt;slug&gt;.yaml</code> plus die ersten Tag-Dateien).</li>
			<li><strong>EWWS-Review:</strong> <code>{ "@MeKo-Tech/ewws" }</code> prüft und merged den Claim und trägt das Repo ins Ruleset <code>vibe-app-repos</code> ein. Nach dem Merge registrieren Workflows der Registry die <code>auth.client_ids</code> automatisch in ewws-auth und geben dem Repo den Tagger-Key frei.</li>
			<li><strong>Build + Tag:</strong> die CI der App baut die Images und schreibt das Tag per <code>build(tags)</code>-PR in die Registry.</li>
			<li><strong>Deploy:</strong> Argo CD deployt die App als <code>&lt;slug&gt;-&lt;stage&gt;</code> in den Namespace <code>tenant-&lt;slug&gt;-&lt;stage&gt;</code>.</li>
		</ol>
		<p>
			Dein Repo spricht nie direkt mit dem Cluster: kein Helm, kein kubectl, keine
			Kubeconfig und nie <code>AZURE_EWWS_KEY_VAULT_CLIENT_SECRET</code>/<code>_ID</code>
			(die gehören der ewws-Infrastruktur). Alles läuft über PRs gegen die Registry.
		</p>
		<div class="docs-callout">
			<strong>Ausführliche Anleitungen:</strong>
			<ul>
				<li>App-Owner: <a href={ templ.SafeURL(docsOnboardingURL) }>Onboarding-Guide in ewws-apps-registry</a> und die MeKoMCP-Ressource <code>platform://guide/new-app</code> (Spiegel von <a href={ templ.SafeURL(docsTemplateAgent) }><code>AGENTS.md</code> im Template</a>, Abschnitt „New app to prod“).</li>
				<li>EWWS-Mitglieder: Runbook <a href={ templ.SafeURL(docsRunbookURL) }>Neue Vibe-App freischalten</a> im ewws-wiki.</li>
				<li>Alle Claim-Felder: <a href={ templ.SafeURL(docsClaimRefURL) }>Claim reference</a>.</li>
			</ul>
		</div>
	</section>
}

templ docsTemplateSection() {
	<section class="docs-section" id="template">
		<h2>2. Repo aus dem Template</h2>
		<pre><code>{ "gh repo create MeKo-Tech/<name> --template MeKo-Tech/go-react-template --private --clone" }</code></pre>
		<p>
			Das Template bringt alles mit, was die Plattform erwartet: Release-Workflow
			(Build, Tag schreiben, Secrets ausliefern), Conventional-Commits-Check,
			release-please, Health-Endpunkte und die Secret-Rezepte. Im Repo füllst du
			<code>platform/claim.yaml</code> aus; daraus liest der Release-Workflow den Slug.
		</p>
		<p>
			Das Repo muss <strong>privat</strong> sein: Die Org-Variable
			<code>EWWS_REGISTRY_TAGGER_APP_ID</code> und das Org-Secret
			<code>EWWS_REGISTRY_TAGGER_PRIVATE_KEY</code>, mit denen die CI Tags schreibt,
			sind für öffentliche Repos nicht freigegeben.
		</p>
	</section>
}

templ docsClaimSection() {
	<section class="docs-section" id="claim">
		<h2>3. Claim über das Formular</h2>
		<p>
			Im <a href="/claim">Claim-Formular</a> trägst du Slug, Repo, Images mit Start-Tag,
			Ressourcen-Limits, Hosts, Env, Shared Secrets und den ewws-auth-Scope ein. Submit öffnet
			einen PR gegen <code>ewws-apps-registry</code> mit <code>apps/&lt;slug&gt;.yaml</code>
			und den ersten Tag-Dateien <code>tags/&lt;slug&gt;/&lt;stage&gt;.yaml</code>, damit Argo
			direkt nach dem Merge deployen kann. Felder, die das Formular nicht kennt
			(<code>sealed_secrets</code>, <code>auth.client_ids</code>, <code>extra_workloads</code> …),
			ergänzt du im PR.
		</p>
		<h3>Slug und Hosts</h3>
		<ul>
			<li>DNS-safe lowercase: <code>^[a-z][a-z0-9-]&#123;2,30&#125;[a-z0-9]$</code>, eindeutig und nicht in <a href={ templ.SafeURL(docsReservedSlugs) }><code>reserved-slugs.yaml</code></a>.</li>
			<li>Hosts: <code>&lt;slug&gt;.apps.meko.dev</code> (staging) und <code>&lt;slug&gt;.apps.meko.work</code> (prod).</li>
		</ul>
		<p>
			Unter <code>images.&lt;c&gt;</code> steht im Claim nur das <code>repository</code>. Das Tag
			liegt ausschließlich in <code>tags/&lt;slug&gt;/&lt;stage&gt;.yaml</code>; ein <code>tag</code>-Key
			im Claim fällt durch die Validierung.
		</p>
		<h3>Weitere Claim-Felder (ab meko-app 2.1.0)</h3>
		<table class="docs-table">
			<thead>
				<tr><th>Feld</th><th>Wozu</th></tr>
			</thead>
			<tbody>
				<tr>
					<td><code>api_path_prefix</code> / <code>api_strip_prefix</code></td>
					<td>Pfad, unter dem das Backend neben dem Frontend hängt (Default <code>/api</code>), und ob der Prefix vor dem Weiterleiten abgeschnitten wird. Ohne Frontend bekommt das Backend <code>/</code>.</td>
				</tr>
				<tr>
					<td><code>extra_workloads</code></td>
					<td>Bis zu 5 zusätzliche Workloads (Worker, Datenbank …), entweder mit dem Image von Backend/Frontend oder einem eigenen gepinnten <code>image</code>; optional mit <code>persistence</code> (PVC) und <code>service</code>.</td>
				</tr>
				<tr>
					<td><code>config_files</code></td>
					<td>Read-only gemountete Konfigurationsdateien. Liegen im Klartext in Git, also keine Secrets.</td>
				</tr>
				<tr>
					<td><code>init_command</code>, <code>command</code>, <code>args</code></td>
					<td>Init-Container vor dem Start (z.B. Migrationen) bzw. Entrypoint und Argumente des Images überschreiben.</td>
				</tr>
				<tr>
					<td><code>sealed_secrets</code></td>
					<td>Nur für <em>zusätzliche</em> Secrets mit einem anderen Namen als <code>&lt;slug&gt;-app</code> oder um <code>&lt;slug&gt;-app</code> auf einzelne Stages zu beschränken. <code>&lt;slug&gt;-app</code> selbst braucht keinen Eintrag, siehe <a href="#secrets">Abschnitt 6</a>.</td>
				</tr>
				<tr>
					<td><code>auth.client_ids</code></td>
					<td>Die eigene ewws-auth-<code>client_id</code> pro Stage (<code>staging</code>, <code>prod</code>), eine selbst erzeugte UUID, siehe <a href="#login">Abschnitt 7</a>.</td>
				</tr>
				<tr>
					<td><code>resource_exception</code></td>
					<td>Begründete Ausnahme über 4Gi / 4 CPU pro Container, siehe <a href="#resources">Abschnitt 8</a>.</td>
				</tr>
			</tbody>
		</table>
		<p>
			Details und Grenzwerte stehen in der <a href={ templ.SafeURL(docsClaimRefURL) }>Claim reference</a>.
		</p>
		<h3>Bootstrap im App-Repo</h3>
		<p>
			Beim Claim legt das Formular außerdem fehlende Standard-Dateien im App-Repo an:
			PR-Titel-Check, release-please und <code>AGENTS.md</code>. Das geschieht ohne PR als
			direkter Commit pro Datei auf den Default-Branch; Dateien, die es schon gibt, bleiben
			unangetastet. Bei einem Repo aus dem Template existiert das meiste davon bereits.
		</p>
		<p>
			Fehlen <code>.sops.yaml</code>, <code>values.env</code> oder <code>values.sops.env</code>,
			legt der Bootstrap auch diese an. Sie gehören zum alten Secret-Ablauf und werden nicht
			mehr ausgewertet: <strong>keine Secrets dort eintragen</strong> und die Dateien wieder
			löschen. Secrets laufen wie in <a href="#secrets">Abschnitt 6</a>.
		</p>
	</section>
}

templ docsReviewSection() {
	<section class="docs-section" id="review">
		<h2>4. Freigabe durch EWWS</h2>
		<p>
			Den Claim-PR reviewt <code>{ "@MeKo-Tech/ewws" }</code> (CODEOWNERS). Pflicht-Checks sind
			<code>validate-apps</code> und <code>tag-scope</code>, nötig ist eine Freigabe, gemergt
			wird per Squash. Rund um den Merge erledigt EWWS:
		</p>
		<ol>
			<li><strong>Login-Client:</strong> nichts von Hand. Die <code>auth.client_ids</code> aus dem Claim registriert der Registry-Workflow <code>sync-auth-clients</code> nach dem Merge automatisch in ewws-auth; ein PR in ewws-auth ist nicht nötig.</li>
			<li><strong>Tagger-Key:</strong> der Registry-Workflow <code>sync-tagger-secret-repos</code> gibt deinem Repo nach dem Merge Zugriff auf <code>EWWS_REGISTRY_TAGGER_PRIVATE_KEY</code>. Scheitert er, führt ein Org-Admin <code>scripts/sync-tagger-secret-repos.sh --apply</code> in <code>ewws-apps-registry</code> von Hand aus. Ohne den Zugriff scheitert das Tag-Schreiben im ersten Release-Lauf.</li>
			<li><strong>Branch-Schutz:</strong> das Repo in die Repo-Liste des Org-Rulesets <code>vibe-app-repos</code> eintragen.</li>
			<li><strong>Erstes Deploy:</strong> Release-Lauf prüfen bzw. neu anstoßen, staging vor prod.</li>
		</ol>
		<p>
			Die Schritte im Detail stehen im Runbook
			<a href={ templ.SafeURL(docsRunbookURL) }>Neue Vibe-App freischalten</a>.
		</p>
	</section>
}

templ docsDeploySection() {
	<section class="docs-section" id="deploy">
		<h2>5. Build, Tag und Deploy</h2>
		<p>
			Der Release-Workflow des Templates baut die Images nach
			<code>ghcr.io/meko-tech/&lt;repo&gt;-backend</code> bzw. <code>-frontend</code> und ruft
			danach den Reusable-Workflow <code>write-registry-tag</code> auf. Der läuft als GitHub App
			<code>ewws-registry-tagger</code>, öffnet einen PR
			<code>{ "build(tags): <slug> <stage> -> …" }</code>, der nur
			<code>tags/&lt;slug&gt;/&lt;stage&gt;.yaml</code> ändert, und merged ihn selbst.
		</p>
		<ul>
			<li>Push auf <code>main</code> → neues Tag für <strong>staging</strong>.</li>
			<li>Veröffentlichtes Release (release-please) → neues Tag für <strong>prod</strong>.</li>
			<li>Tags sind unveränderlich (<code>sha-c758f9c</code>, <code>1.4.0</code>); <code>latest</code> wird abgelehnt.</li>
			<li>Der Claim muss auf <code>main</code> der Registry liegen, bevor der Workflow läuft.</li>
		</ul>
		<pre><code>{ docsTagFileSnippet() }</code></pre>
		<p>
			Das ApplicationSet <code>vibe-tenants</code> legt pro Claim die Argo-CD-Applications
			<code>&lt;slug&gt;-staging</code> und <code>&lt;slug&gt;-prod</code> an, Ziel-Namespaces sind
			<code>tenant-&lt;slug&gt;-staging</code> und <code>tenant-&lt;slug&gt;-prod</code>. Gerendert wird der
			Chart <code>meko-app</code> aus Claim und Tag-Datei, mit Auto-Sync, <code>prune</code> und
			<code>selfHeal</code>: Änderungen von Hand im Cluster setzt Argo zurück. Den Stand
			siehst du auf der <a href="/">Landing-Seite</a>.
		</p>
		<p>
			Rollback ist ein normaler PR auf <code>tags/&lt;slug&gt;/&lt;stage&gt;.yaml</code>.
		</p>
	</section>
}

func docsTagFileSnippet() string {
	return `# tags/<slug>/staging.yaml — schreibt nur die App-CI
imageTags:
  backend: "sha-c758f9c"
  frontend: "sha-c758f9c"
`
}

templ docsSecretsSection() {
	<section class="docs-section" id="secrets">
		<h2>6. Secrets (SOPS → SealedSecrets)</h2>
		<p>
			Secret-Werte stehen nie im Klartext im Claim, im Repo, im Image oder in der CI.
			Sie liegen SOPS-verschlüsselt im App-Repo und kommen als SealedSecret über die
			Registry in den Cluster:
		</p>
		<pre><code>{ docsSecretsFlowSnippet() }</code></pre>
		<p>
			<strong>Der Normalfall ist ein Secret <code>&lt;slug&gt;-app</code> pro Stage, ohne Claim-Eintrag.</strong>
			Der Chart lädt es automatisch per <code>envFrom</code> (optional, als erste Quelle; spätere
			<code>env</code>-Einträge gewinnen) in den Backend-Container und dessen <code>init_command</code>,
			in CronJobs mit <code>component: backend</code> (Default) und in <code>extra_workloads</code>
			mit <code>image_from: backend</code>. Frontend, Frontend-Jobs und <code>extra_workloads</code>
			mit eigenem <code>image</code> bekommen es nicht.
		</p>
		<ol>
			<li><code>just secrets-login</code>, dann einen Wert mit <code>pbpaste | just secrets-set &lt;stage&gt; &lt;KEY&gt;</code> (Wert über stdin, landet in <code>&lt;slug&gt;-app</code>) oder alles mit <code>just secrets-edit &lt;stage&gt;</code> in <code>secrets/&lt;stage&gt;.sops.yaml</code> ablegen. Verschlüsselt wird nur mit dem Key <code>sops-key-vibe</code> im Key Vault <code>meko-vibe-vault</code>, nie mit <code>mekorp-vault</code>.</li>
			<li><code>just secrets-seal</code> versiegelt lokal (<code>kubeseal --scope strict</code>, Namespace <code>tenant-&lt;slug&gt;-&lt;stage&gt;</code>) nach <code>deploy/sealed/&lt;stage&gt;/&lt;slug&gt;-app.yaml</code>; das wird committet. Versiegelt wird nie in der CI.</li>
			<li>Der Release-Workflow (<code>write-registry-secrets</code>) kopiert die SealedSecrets nach <code>secrets/&lt;slug&gt;/&lt;stage&gt;/</code> in der Registry. Dafür entschlüsselt die CI nichts und braucht keinen Key-Vault-Zugriff. Muss ein Workflow doch SOPS entschlüsseln (z.B. ein Test mit Secret), setzt er <code>AZURE_CLIENT_ID: { "${{ vars.VIBE_CODE_KEY_VAULT_CLIENT_ID }}" }</code>, <code>AZURE_CLIENT_SECRET: { "${{ secrets.VIBE_CODE_KEY_VAULT_CLIENT_SECRET }}" }</code> und <code>AZURE_TENANT_ID: { "${{ vars.AZURE_TENANT_ID }}" }</code>, nie die <code>AZURE_EWWS_KEY_VAULT_*</code>-Credentials.</li>
			<li>Im Claim ist für <code>&lt;slug&gt;-app</code> nichts zu tun.</li>
		</ol>
		<p>
			<code>sealed_secrets</code> im Claim brauchst du nur für <strong>zusätzliche</strong> Secrets mit
			einem anderen Namen (weiterer Top-Level-Key in der SOPS-Datei, z.B. das Passwort einer
			Datenbank neben der App) oder um <code>&lt;slug&gt;-app</code> per <code>stages</code> auf
			einzelne Stages zu beschränken. Solche Secrets referenzierst du über
			<code>env_from</code> oder <code>env</code>:
		</p>
		<pre><code>{ docsSealedSecretsSnippet() }</code></pre>
		<p>
			Den Zugriff auf <code>meko-vibe-vault</code> gibt EWWS frei. Ausführlich:
			<a href={ templ.SafeURL(docsTemplateAgent + "#secrets") }>Secrets im Template-<code>AGENTS.md</code></a>
			und MeKoMCP <code>platform://guide/secrets</code>.
		</p>
		<h3>Shared Secrets der Plattform</h3>
		<p>
			Bundles wie <code>ipoffice-readonly</code> (<code>IPOFFICE_DB_HOST</code>, <code>_PORT</code>,
			<code>_NAME</code>, <code>_USER</code>, <code>_PASSWORD</code>, <code>_DSN</code>) stellt die
			Plattform bereit. Du aktivierst sie im Claim unter <code>shared_secrets</code>; sie landen
			am Backend-Pod, nie im Frontend. Der Name <code>&lt;slug&gt;-app</code> ist dort reserviert.
		</p>
		<div class="docs-callout">
			<strong>IPOffice aus Linux-Containern:</strong> Windows-Auth (
			<em>
				Integrated
				Authentication
			</em>) gegen MSSQL funktioniert im Cluster nicht. Nutze SQL-Auth mit den
			Env-Vars oben, z.B. direkt <code>IPOFFICE_DB_DSN</code>.
		</div>
	</section>
}

func docsSecretsFlowSnippet() string {
	return `App-Repo                        ewws-apps-registry                Cluster
secrets/<stage>.sops.yaml
  --just secrets-seal-->  deploy/sealed/<stage>/<name>.yaml
  --CI: write-registry-secrets-->  secrets/<slug>/<stage>/<name>.yaml
  --Argo CD-->  SealedSecret -> Secret <name> in tenant-<slug>-<stage>
`
}

func docsSealedSecretsSnippet() string {
	return `# in apps/<slug>.yaml — nur für ein zusätzliches Secret, nicht für <slug>-app
sealed_secrets:
  - name: meine-app-db
extra_workloads:
  - name: postgres
    # ...
    env:
      POSTGRES_PASSWORD: {secret: meine-app-db, key: POSTGRES_PASSWORD}
`
}

templ docsLoginSection() {
	<section class="docs-section" id="login">
		<h2>7. Login über ewws-auth</h2>
		<p>
			Jede App bekommt ihre <strong>eigene <code>client_id</code></strong>. Eine ID aus einer
			anderen App, aus moin-bridge oder aus alten Templates zu kopieren ist nicht erlaubt:
			ewws-auth hängt das Session-Cookie am Client. Die Registry ist die Quelle der Wahrheit
			für die Clients der Vibe-Apps; ein PR in ewws-auth ist nicht nötig.
		</p>
		<ol>
			<li>Je Stage eine neue UUID erzeugen (<code>uuidgen | tr A-Z a-z</code>), nie eine kopieren.</li>
			<li>Die IDs in den Claim unter <code>auth.client_ids.staging</code> / <code>.prod</code> eintragen (andere Stages gibt es nicht). <code>validate-apps</code> prüft das Format, dass kein anderer Claim dieselbe ID nennt und dass die Hosts der Stage unter <code>.apps.meko.dev</code> bzw. <code>.apps.meko.work</code> liegen.</li>
			<li>Nach dem Merge registriert der Registry-Workflow <code>sync-auth-clients</code> die IDs automatisch im Issuer der Stage, mit <code>https://&lt;host&gt;/**</code> für <code>stages.&lt;s&gt;.host</code> und jeden Eintrag in <code>extra_hosts</code>. Einen Eintrag unter <code>oidcPublicClients</code> in ewws-auth bekommen Vibe-Apps nicht.</li>
			<li>Der Chart setzt in jedem Container der Stage (Backend, Frontend, Init, CronJobs, <code>extra_workloads</code>) <code>EWWS_AUTH_CLIENT_ID</code> und <code>EWWS_AUTH_ISSUER</code> (<code>https://login.ewws.meko.dev</code> für staging, <code>https://login.meko.work</code> für prod). Issuer und Client-ID nicht von Hand in <code>env</code> setzen: ein gleichnamiger Eintrag überschreibt den injizierten Wert, und ein altes <code>APP_AUTH_ISSUER</code> gehört aus dem Claim entfernt.</li>
			<li>Das Frontend kann Container-Env zur Laufzeit nicht lesen; sein Server muss die Werte durchreichen. Im Template holt das Frontend sie zur Laufzeit vom Backend (<code>GET /api/v1/config</code>).</li>
		</ol>
		<p>
			<strong>Lokal entwickeln:</strong> immer gegen den dev-Issuer
			<code>https://login.ewws.meko.dev</code>; dort ist für jeden registrierten Client jeder
			Loopback-Port erlaubt, gegen prod keiner.
		</p>
		<p>
			Noch akzeptiert ewws-auth auch Logins ohne registrierten Client. Das wird abgeschaltet;
			danach kann sich eine App ohne ihre <code>auth.client_ids</code> im Claim nicht mehr anmelden.
		</p>
		<p>
			<code>auth.scope</code> verknüpft die App nur in dieser UI mit ihrem ewws-auth-Scope und
			vergibt keine Rechte. <code>features.ingress_auth</code> nimmt das Schema zwar an, es wird
			aber nirgends ausgewertet: Es stellt <strong>keinen</strong> Login vor die App. Regeln:
			<a href={ templ.SafeURL(docsAuthClients) }>ewws-auth <code>docs/clients.md</code></a>.
		</p>
	</section>
}

templ docsResourcesSection() {
	<section class="docs-section" id="resources">
		<h2>8. Ressourcen und Container-Regeln</h2>
		<h3>Limits</h3>
		<ul>
			<li>Pro Container setzt du <code>resources.&lt;c&gt;.memory_limit</code> und <code>cpu_limit</code>. Plattform-Default sind 128Mi / 500m; darüber setzt der Chart einen Cap-Override, den der Review sieht.</li>
			<li>Ohne Ausnahme sind maximal <strong>4Gi / 4 CPU pro Container</strong> erlaubt.</li>
			<li>Mehr geht nur mit <code>resource_exception</code> (Begründung mit 20–500 Zeichen, bis 32Gi / 8 CPU). Die Ausnahme braucht die <strong>Freigabe von <code>{ "@MeKo-Tech/ewws" }</code></strong> im Claim-PR.</li>
		</ul>
		<pre><code>{ docsResourceExceptionSnippet() }</code></pre>
		<h3>Container-Regeln</h3>
		<ul>
			<li>Der Container lauscht auf <strong>8080</strong>; Ports unter 1024 gehen nicht (für nginx <code>nginxinc/nginx-unprivileged</code>).</li>
			<li>Er läuft <strong>non-root</strong> (Standard-UID 1000, sonst <code>components.&lt;c&gt;.run_as_user</code>).</li>
			<li>Das Root-Dateisystem ist <strong>read-only</strong>. Schreibbar sind <code>/tmp</code>, <code>/var/cache/nginx</code> und <code>/var/run</code>; weitere Pfade unter <code>writable_dirs</code>, Daten, die einen Neustart überleben sollen, unter <code>persistence</code>.</li>
			<li>Health-Endpunkte: Default prüft der Chart <code>GET /healthz</code> (Backend) bzw. <code>GET /</code> (Frontend); das Template nutzt <code>/livez</code> und <code>/readyz</code> unter <code>components.&lt;c&gt;.probes</code>.</li>
		</ul>
		<pre><code>{ docsWritableDirsSnippet() }</code></pre>
	</section>
}

func docsResourceExceptionSnippet() string {
	return `# in apps/<slug>.yaml — nur mit Freigabe von @MeKo-Tech/ewws
resource_exception:
  reason: "Bildanalyse lädt das Modell komplett in den RAM (Ticket MEK-1234)"
  memory_limit: 8Gi
  cpu_limit: "4"
`
}

func docsWritableDirsSnippet() string {
	return `# in apps/<slug>.yaml
writable_dirs:
  backend:
    - /app/backend/data
  frontend:
    - /etc/nginx/conf.d
`
}

templ docsFAQSection() {
	<section class="docs-section" id="faq">
		<h2>9. FAQ und Hilfe</h2>
		<details>
			<summary>Mein Release-Lauf scheitert beim Tag-Schreiben.</summary>
			<p>
				Meist liegt der Claim noch nicht auf <code>main</code> der Registry, oder das Repo hat
				noch keinen Zugriff auf den Tagger-Key, weil der Workflow
				<code>sync-tagger-secret-repos</code> noch nicht gelaufen oder gescheitert ist
				(<a href="#review">Abschnitt 4</a>). Im Zweifel bei EWWS melden, danach den Lauf neu anstoßen.
			</p>
		</details>
		<details>
			<summary>Warum sehe ich auf dem Dashboard 0 Requests?</summary>
			<p>
				Drei Möglichkeiten:
				(1) <code>increase([24h])</code> braucht zwei Datenpunkte 24h auseinander — bei neuen
				Apps also Geduld.
				(2) Dein Slug matched den Service-Label-Regex nicht — selten, lass EWWS kurz prüfen.
				(3) Deine App hat tatsächlich keinen Traffic — siehe die "verwaist"-Klassifikation.
			</p>
		</details>
		<details>
			<summary>Wie schalte ich eine App ab?</summary>
			<p>
				PR gegen <code>ewws-apps-registry</code>, der <code>apps/&lt;slug&gt;.yaml</code>,
				<code>tags/&lt;slug&gt;/</code> und <code>secrets/&lt;slug&gt;/</code> löscht. Die App läuft danach
				weiter, bis EWWS die Applications und Namespaces entfernt — im PR Bescheid geben.
				PVCs gehen dabei verloren. Der Weg zurück steht im
				<a href={ templ.SafeURL(docsOnboardingURL) }>Onboarding-Guide</a>.
			</p>
		</details>
		<details>
			<summary>Was ist mit Backend-only oder Frontend-only Apps?</summary>
			<p>
				<code>repo.has_backend: false</code> oder <code>repo.has_frontend: false</code>. Der Chart
				lässt das jeweilige Deployment weg; ein Backend ohne Frontend bekommt <code>/</code> statt
				<code>api_path_prefix</code>.
			</p>
		</details>
		<details>
			<summary>Wo frage ich nach?</summary>
			<p>
				Bei <code>{ "@MeKo-Tech/ewws" }</code>, im Claim-PR oder direkt. Für AI-Agenten im Repo:
				MeKoMCP <code>platform://guide/new-app</code>.
			</p>
		</details>
	</section>
}
